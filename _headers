/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# รูปและวิดีโอชื่อไฟล์ไม่เคยเปลี่ยน ให้เบราว์เซอร์เก็บไว้ 30 วันจะได้ไม่ต้องถามซ้ำทุกครั้ง
# หน้าเว็บมีรูป 81 ใบ ถ้าไม่ตั้งค่านี้ คนที่เคยเข้าแล้วต้องยิงถามใหม่ทุกใบ
# ไม่ใส่ immutable เพราะถ้าวันหนึ่งเปลี่ยนรูปโดยใช้ชื่อไฟล์เดิม จะได้กด refresh แล้วเห็นของใหม่
/img/*
  Cache-Control: public, max-age=2592000

# รูปตารางราคาเก่าและไฟล์ฝาแฝดของหน้าแรก หน้าเว็บไม่ได้เรียกใช้แต่เปิดจาก URL ตรงได้
# กันไม่ให้ Google เก็บไปโชว์ราคาที่หมดอายุแล้ว
/img/price.jpg
  X-Robots-Tag: noindex

/img/contact.jpg
  X-Robots-Tag: noindex

/base.html
  X-Robots-Tag: noindex

# หน้าจัดการค่าบริการ ไม่ให้ค้นเจอ ไม่ให้ฝัง iframe และล็อกไม่ให้หน้านี้ยิงออกไปที่อื่น
# นอกจาก api.github.com อย่างเดียว ถ้ามีสคริปต์แปลกปลอมหลุดเข้ามาก็ส่งข้อมูลออกไม่ได้
/admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src https://api.github.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'

/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src https://api.github.com; form-action 'none'; base-uri 'none'; frame-ancestors 'none'
